# Base URL of the FlameSight FastAPI backend (no trailing slash). Placeholder only; never commit a real URL here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Stub mode: anything other than "false" reads sample data from src/stub/*.json and shows the stub banner.
# Set to false (with a real API URL) to use the live backend.
NEXT_PUBLIC_USE_STUB=true
# Optional: client request timeout in ms (default 10000).
# NEXT_PUBLIC_API_TIMEOUT_MS=10000
# Optional CORS fallback (off by default): proxy /api/* to the backend through Next.js.
# Set API_PROXY_TARGET to the backend URL and NEXT_PUBLIC_API_BASE_URL=/api.
# API_PROXY_TARGET=
# Optional: public site URL (no trailing slash) for Open Graph, sitemap and robots absolute URLs.
# NEXT_PUBLIC_SITE_URL=
